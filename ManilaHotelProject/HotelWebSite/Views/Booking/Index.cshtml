
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="box-body">
    <div align="center" class="box-header with-border callout callout-info">
        <h4>Booking List</h4>
        @*<%--<asp:HyperLink ID="HyperLink1" Font-Underline="False" NavigateUrl="~/mo/Bookings.aspx"
            CssClass="add button">+New Booking</asp:HyperLink>--%>*@
    </div>
    <input type="hidden" ID="BookingID" name="BookingID" />
    <div class="row">
        <div class="col-md-2">
            <div class="form-group">
                <label for="Properties">Properties</label>
                <select class="form-control" style="height:34px;width:100%"
                        id="Properties" name="Properties">
                    <option selected="selected" value="0">Please select</option>
                </select>
            </div>
        </div>
        <div class="col-md-2">
            <div class="form-group">
                <label>
                    Date From:
                </label>

                <input type="date" ID="txtCheckIn" name="txtCheckIn" autocomplete="off" ToolTip="Enter From Date"
                       class="form-control" />
            </div>
        </div>

        <div class="col-md-2">
            <div class="form-group">
                <label>
                    Date To:
                </label>
                <input type="date" ID="txtCheckOut" autocomplete="off" ToolTip="Enter To Date" class="form-control" />
            </div>
        </div>

        <div class="col-md-2">
            <div class="form-group">
                <label>
                    Booking Status
                </label>

                <select id="BookingStatus" class="form-control">
                    <option Value="-1">All</option>
                    <option Value="Booked">Booked</option>
                    <option Value="CheckedIn">CheckedIn</option>
                    <option Value="Cancelled">Cancel</option>
                    <option Value="Paid">Paid</option>
                </select>
            </div>
        </div>

        <div class="col-md-2">
            <div class="form-group">
                <label>
                    Category Name
                </label>

                <select id="RoomCategory" class="form-control">
                    <option Value="All">All</option>
                </select>
            </div>
        </div>
        <div class="col-md-2">
            <div class="form-group">
                <label>
                </label>
                <div align="center">
                    <input type="button" id="showlist" class="btn btn-primary" value="Search" />
                </div>
            </div>
        </div>
    </div>


    <br />


    <div class="row">
        <div class="col-md-12 col-xs-12">
            <table class="table" id="bookings">
                <tr>
                    <th>Booking ID</th>
                    <th>Customer Name</th>
                    <th>Mobile No.</th>
                    <th>Room Category</th>
                    <th>Res. Date</th>
                    <th>CheckIn</th>
                    <th>CheckOut</th>
                    <th>Adults</th>
                    <th>Children</th>
                    <th>Amount Paid</th>
                    <th></th>
                    <th></th>
                </tr>
                <tbody>
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="modal fade" id="ChangeRoomModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalCenterTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLongTitle">Available Rooms</h5>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="form-inline">
                        <div class="form-group">
                            <label></label>
                            <select name="RoomNum" class="form-control" id="RoomNum">
                                <option Value="All">Choose</option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" id="closePic" class="btn btn-secondary">Close</button>
                <button type="button" id="Save" class="btn btn-primary">Save</button>
            </div>
        </div>
    </div>
</div>


<script src="~/Content/Admin/plugins/jQuery/jquery-2.2.3.min.js"></script>
<script src="~/Scripts/EntityScript/BookingList.js"></script>
